  <div class="modal-card">
    <div class="modal-icon" id="mdIcon">🎉</div>
    <h2 id="mdTitle">Selamat!</h2>
    <p id="mdSub"></p>
    <div class="modal-stats" id="mdStats"></div>
    <button class="btn primary" id="mdAgain">🔁  Main Lagi</button>
    <button class="btn ghost" id="mdHome" style="margin-top:9px">🏠  Kembali ke Menu</button>
  </div>
</div>

