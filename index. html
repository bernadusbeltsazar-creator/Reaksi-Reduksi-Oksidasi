<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#070b16">
<title>Redoks Quest — Game Kimia Redoks SMA</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
  --card:rgba(16,23,42,.80);
  --card2:rgba(26,36,62,.88);
  --line:rgba(120,170,255,.16);
  --txt:#e9efff;
  --dim:#8fa1c7;
  --green:#3ddc97;
  --amber:#ffc043;
  --red:#ff5c7a;
  --blue:#4d8dff;
  --purple:#a86bff;
}
html,body{height:100%}
body{
  background:radial-gradient(circle at 50% 0%,#12203f 0%,#070b16 55%,#04060d 100%);
  color:var(--txt);
  font-family:"Segoe UI",system-ui,-apple-system,"Helvetica Neue",Arial,sans-serif;
  min-height:100vh;overflow-x:hidden;display:flex;justify-content:center;
}
#bg{
  position:fixed;top:0;bottom:0;left:0;right:0;margin:0 auto;
  width:100%;max-width:520px;height:100%;z-index:0;display:block;
}
.app{
  position:relative;z-index:1;width:100%;max-width:520px;min-height:100vh;
  padding:14px 14px 40px;display:flex;flex-direction:column;
}
/* ---------- SCREENS ---------- */
.screen{display:none;flex-direction:column;gap:12px;animation:fade .32s ease}
.screen.active{display:flex}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
/* ---------- TYPO ---------- */
h1{font-size:36px;font-weight:800;letter-spacing:1px;line-height:.95;text-align:center}
h1 em{
  display:block;font-style:normal;font-size:19px;letter-spacing:7px;margin-top:4px;
  background:linear-gradient(90deg,var(--green),var(--blue),var(--purple));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
h2{font-size:17px;font-weight:700}
h3{font-size:14px;font-weight:700;margin-bottom:10px;color:#cfe0ff}
.muted{color:var(--dim);font-size:12.5px;line-height:1.55}
/* ---------- HOME ---------- */
.hero{text-align:center;padding:16px 0 2px}
.logo{
  font-size:46px;line-height:1;margin-bottom:10px;
  filter:drop-shadow(0 0 20px rgba(61,220,151,.65));
  animation:pulse 2.6s ease-in-out infinite;
}
@keyframes pulse{0%,100%{transform:scale(1) rotate(0)}50%{transform:scale(1.12) rotate(-6deg)}}
.tag{color:var(--dim);font-size:13px;margin-top:10px;letter-spacing:.4px}
.card{
  background:var(--card);border:1px solid var(--line);border-radius:16px;
  padding:14px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
}
.lbl{display:block;font-size:11.5px;color:var(--dim);margin-bottom:6px;letter-spacing:.6px;text-transform:uppercase}
.inp{
  width:100%;padding:12px 14px;border-radius:12px;border:1px solid var(--line);
  background:rgba(8,13,26,.7);color:var(--txt);font-size:15px;font-family:inherit;outline:none;
}
.inp:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(77,141,255,.15)}
.chips{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.chip{
  background:var(--card);border:1px solid var(--line);border-radius:14px;
  padding:10px 6px;text-align:center;
}
.chip b{display:block;font-size:17px;color:var(--green);font-variant-numeric:tabular-nums}
.chip span{font-size:10px;color:var(--dim);letter-spacing:.4px}
/* ---------- BUTTONS ---------- */
.btn{
  width:100%;padding:14px;border-radius:14px;border:none;font-family:inherit;
  font-size:14.5px;font-weight:700;letter-spacing:.4px;cursor:pointer;
  transition:transform .12s ease,filter .12s ease;touch-action:manipulation;
  display:block;text-align:center;
}
.btn:active{transform:scale(.97);filter:brightness(1.1)}
.btn.primary{
  background:linear-gradient(135deg,var(--green),#22b47a);color:#04140d;
  box-shadow:0 8px 26px -8px rgba(61,220,151,.75);
}
.btn.ghost{background:rgba(255,255,255,.05);color:var(--txt);border:1px solid var(--line)}
.btn.danger{background:rgba(255,92,122,.13);color:var(--red);border:1px solid rgba(255,92,122,.3)}
.btn.small{width:auto;padding:10px 20px;font-size:13px;margin-top:10px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
/* ---------- QUIZ ---------- */
.qtop{display:flex;align-items:center;gap:10px}
.icon{
  width:38px;height:38px;flex:0 0 38px;border-radius:12px;border:1px solid var(--line);
  background:rgba(255,255,255,.05);color:var(--txt);font-size:16px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;font-family:inherit;
}
.icon:active{transform:scale(.94)}
.qmeta{flex:1;text-align:center;line-height:1.25}
.qlevel{font-size:11px;color:var(--dim);letter-spacing:.8px;text-transform:uppercase}
.qlevel b{color:var(--txt)}
.qprize{
  font-size:19px;font-weight:800;color:var(--amber);font-variant-numeric:tabular-nums;
  text-shadow:0 0 18px rgba(255,192,67,.45);
}
.progress{height:5px;border-radius:5px;background:rgba(255,255,255,.07);overflow:hidden}
.progress i{display:block;height:100%;width:0;border-radius:5px;
  background:linear-gradient(90deg,var(--green),var(--blue));transition:width .4s ease}
.lifelines{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.life{
  padding:10px 4px;border-radius:12px;border:1px solid var(--line);
  background:rgba(255,255,255,.05);color:var(--txt);font-size:11.5px;font-weight:600;
  font-family:inherit;cursor:pointer;transition:.15s;touch-action:manipulation;
}
.life:active{transform:scale(.95)}
.life.used{opacity:.28;pointer-events:none;text-decoration:line-through}
.qbox{
  background:var(--card2);border:1px solid var(--line);border-radius:16px;
  padding:16px 15px;font-size:15px;line-height:1.55;min-height:96px;
  display:flex;align-items:center;backdrop-filter:blur(10px);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05);
}
.options{display:flex;flex-direction:column;gap:9px}
.opt{
  display:flex;align-items:center;gap:11px;text-align:left;width:100%;
  padding:13px 13px;border-radius:14px;border:1px solid var(--line);
  background:rgba(255,255,255,.045);color:var(--txt);font-size:13.6px;line-height:1.4;
  font-family:inherit;cursor:pointer;transition:.16s;touch-action:manipulation;
}
.opt:active{transform:scale(.985)}
.opt .ltr{
  flex:0 0 26px;height:26px;border-radius:9px;background:rgba(77,141,255,.16);
  color:#9dc0ff;display:flex;align-items:center;justify-content:center;
  font-weight:800;font-size:12px;
}
.opt.correct{background:rgba(61,220,151,.16);border-color:var(--green);box-shadow:0 0 22px -6px rgba(61,220,151,.7)}
.opt.correct .ltr{background:var(--green);color:#04140d}
.opt.wrong{background:rgba(255,92,122,.15);border-color:var(--red)}
.opt.wrong .ltr{background:var(--red);color:#fff}
.opt.gone{opacity:.16;pointer-events:none}
.opt.dis{pointer-events:none}
.feedback{display:none;border-radius:14px;padding:13px 14px;font-size:12.8px;line-height:1.55}
.feedback.show{display:block;animation:fade .3s ease}
.feedback b{display:block;font-size:14px;margin-bottom:5px}
.feedback.ok{background:rgba(61,220,151,.10);border:1px solid rgba(61,220,151,.35)}
.feedback.ok b{color:var(--green)}
.feedback.bad{background:rgba(255,92,122,.10);border:1px solid rgba(255,92,122,.35)}
.feedback.bad b{color:var(--red)}
/* ---------- LADDER ---------- */
.ladder{
  position:fixed;top:0;bottom:0;left:0;right:0;margin:0 auto;width:100%;max-width:520px;
  background:rgba(5,9,18,.93);backdrop-filter:blur(14px);z-index:40;
  padding:20px 18px;overflow-y:auto;display:none;
}
.ladder.show{display:block;animation:fade .25s ease}
.ladder h3{margin-bottom:14px;font-size:15px}
.ladder ul{list-style:none;display:flex;flex-direction:column-reverse;gap:5px}
.ladder li{
  display:flex;justify-content:space-between;align-items:center;
  padding:8px 13px;border-radius:10px;font-size:12.5px;color:var(--dim);
  font-variant-numeric:tabular-nums;
}
.ladder li.safe{color:var(--amber);font-weight:700}
.ladder li.now{background:linear-gradient(90deg,rgba(61,220,151,.22),rgba(77,141,255,.12));
  color:#fff;font-weight:800;border:1px solid rgba(61,220,151,.4)}
.ladder li.done{color:var(--green);opacity:.85}
/* ---------- MODAL ---------- */
.modal{
  position:fixed;top:0;bottom:0;left:0;right:0;margin:0 auto;width:100%;max-width:520px;
  background:rgba(4,7,14,.86);backdrop-filter:blur(12px);z-index:50;
  display:none;align-items:center;justify-content:center;padding:22px;
}
.modal.show{display:flex;animation:fade .3s ease}
.modal-card{
  width:100%;background:var(--card2);border:1px solid var(--line);border-radius:22px;
  padding:24px 18px;text-align:center;
  box-shadow:0 30px 70px -20px rgba(0,0,0,.9),inset 0 1px 0 rgba(255,255,255,.06);
}
.modal-icon{font-size:52px;margin-bottom:8px;animation:pulse 1.6s ease-in-out infinite}
.modal-card h2{font-size:22px;margin-bottom:8px}
.modal-card p{color:var(--dim);font-size:13px;line-height:1.6;margin-bottom:14px}
.modal-stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px}
.modal-stats div{background:rgba(255,255,255,.05);border-radius:12px;padding:10px}
.modal-stats b{display:block;font-size:17px;color:var(--amber)}
.modal-stats span{font-size:10.5px;color:var(--dim)}
/* ---------- MATERI ---------- */
.mat{display:flex;flex-direction:column;gap:12px;padding-bottom:20px}
.mat h4{font-size:13.5px;color:var(--green);margin-bottom:8px}
.mat p,.mat li{font-size:12.8px;line-height:1.68;color:#c9d7f2}
.mat ul{padding-left:18px;display:flex;flex-direction:column;gap:5px}
.mat code{
  background:rgba(77,141,255,.14);color:#a8c8ff;padding:1px 6px;border-radius:6px;
  font-size:12px;font-family:ui-monospace,Menlo,Consolas,monospace;
}
table{width:100%;border-collapse:collapse;font-size:12px;margin-top:6px}
th,td{padding:7px 8px;text-align:left;border-bottom:1px solid var(--line)}
th{color:var(--dim);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.5px}
td:first-child{color:var(--green);font-weight:700}
/* ---------- STATS ---------- */
.chips.big{grid-template-columns:1fr 1fr}
.badges{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.badge{
  text-align:center;padding:9px 3px;border-radius:13px;border:1px solid var(--line);
  background:rgba(255,255,255,.03);opacity:.28;filter:grayscale(1);
}
.badge.on{opacity:1;filter:none;background:rgba(255,192,67,.09);border-color:rgba(255,192,67,.35)}
.badge i{display:block;font-style:normal;font-size:21px;margin-bottom:3px}
.badge span{font-size:8.5px;color:var(--dim);line-height:1.2;display:block}
.history{display:flex;flex-direction:column;gap:6px;max-height:190px;overflow-y:auto}
.hitem{
  display:flex;justify-content:space-between;align-items:center;font-size:11.5px;
  padding:8px 11px;border-radius:10px;background:rgba(255,255,255,.04);color:var(--dim);
}
.hitem b{color:var(--amber);font-variant-numeric:tabular-nums}
.json-preview{
  margin-top:12px;max-height:150px;overflow:auto;font-size:10px;line-height:1.5;
  background:rgba(0,0,0,.4);border-radius:10px;padding:10px;color:#7fb0ff;
  font-family:ui-monospace,Menlo,Consolas,monospace;white-space:pre-wrap;word-break:break-all;
}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:rgba(120,170,255,.25);border-radius:5px}
</style>
</head>
<body>

<canvas id="bg"></canvas>

<div class="app">

  <!-- ============ HOME ============ -->
  <section id="s-home" class="screen active">
    <div class="hero">
      <div class="logo">⚡</div>
      <h1>REDOKS<em>QUEST</em></h1>
      <p class="tag">Kuis Reaksi Reduksi &amp; Oksidasi · Kimia SMA</p>
    </div>

    <div class="card">
      <label class="lbl" for="playerName">Nama Pemain</label>
      <input id="playerName" class="inp" maxlength="18" placeholder="Tulis namamu di sini...">
    </div>

    <div class="chips">
      <div class="chip"><b id="hPoin">0</b><span>TOTAL POIN</span></div>
      <div class="chip"><b id="hLevel">0</b><span>LEVEL TERBAIK</span></div>
      <div class="chip"><b id="hGames">0</b><span>KUIS</span></div>
    </div>

    <button class="btn primary" id="btnStart">▶  MULAI KUIS</button>
    <div class="row">
      <button class="btn ghost" data-go="materi">📚 Materi</button>
      <button class="btn ghost" data-go="stats">📊 Progres</button>
    </div>
    <p class="muted" style="text-align:center;margin-top:4px">
      15 level · 3 bantuan · babak aman di level 5 &amp; 10
    </p>
  </section>

  <!-- ============ QUIZ ============ -->
  <section id="s-quiz" class="screen">
    <div class="qtop">
      <button class="icon" id="btnQuit">✕</button>
      <div class="qmeta">
        <div class="qlevel">Level <b id="qLevel">1</b> / 15</div>
        <div class="qprize" id="qPrize">100</div>
      </div>
      <button class="icon" id="btnLadder">☰</button>
    </div>

    <div class="progress"><i id="qBar"></i></div>

    <div class="lifelines">
      <button class="life" id="lf50">50 : 50</button>
      <button class="life" id="lfHint">💡 Petunjuk</button>
      <button class="life" id="lfSwap">🔄 Ganti Soal</button>
    </div>

    <div class="qbox" id="qText">Memuat soal...</div>
    <div class="options" id="qOptions"></div>
    <div class="feedback" id="qFeedback"></div>
  </section>

  <!-- ============ MATERI ============ -->
  <section id="s-materi" class="screen">
    <div class="qtop">
      <button class="icon" data-go="home">←</button>
      <div class="qmeta"><div class="qprize" style="font-size:16px">📚 Materi Redoks</div></div>
      <span style="width:38px"></span>
    </div>

    <div class="mat">
      <div class="card">
        <h4>1. Apa Itu Reaksi Redoks?</h4>
        <p>Redoks = <b>RED</b>uksi + <b>OKS</b>idasi yang terjadi <b>bersamaan</b>. Tidak mungkin ada oksidasi tanpa reduksi — jumlah elektron yang dilepas selalu sama dengan yang diterima.</p>
        <ul style="margin-top:9px">
          <li><b>Oksidasi</b> → melepas elektron, bilangan oksidasi <b>naik</b></li>
          <li><b>Reduksi</b> → menerima elektron, bilangan oksidasi <b>turun</b></li>
        </ul>
      </div>

      <div class="card">
        <h4>2. Aturan Bilangan Oksidasi (Biloks)</h4>
        <table>
          <tr><th>Aturan</th><th>Nilai</th></tr>
          <tr><td>Unsur bebas</td><td>0</td></tr>
          <tr><td>Ion monoatomik</td><td>= muatannya</td></tr>
          <tr><td>Golongan IA / IIA</td><td>+1 / +2</td></tr>
          <tr><td>Hidrogen (H)</td><td>+1 (hidrida logam: −1)</td></tr>
          <tr><td>Oksigen (O)</td><td>−2 (peroksida: −1)</td></tr>
          <tr><td>Total senyawa netral</td><td>0</td></tr>
          <tr><td>Total ion poliatomik</td><td>= muatan ion</td></tr>
        </table>
        <p style="margin-top:10px">Contoh: biloks S dalam <code>SO₄²⁻</code> → x + 4(−2) = −2 → <b>x = +6</b></p>
      </div>

      <div class="card">
        <h4>3. Oksidator &amp; Reduktor</h4>
        <table>
          <tr><th>Zat</th><th>Sifat</th></tr>
          <tr><td>Oksidator</td><td>menerima e⁻ · biloks turun · <b>mengalami reduksi</b></td></tr>
          <tr><td>Reduktor</td><td>melepas e⁻ · biloks naik · <b>mengalami oksidasi</b></td></tr>
        </table>
        <p style="margin-top:10px">Contoh: <code>Zn + CuSO₄ → ZnSO₄ + Cu</code><br>
        Zn = reduktor (0 → +2), CuSO₄ = oksidator (Cu²⁺ → Cu).</p>
      </div>

      <div class="card">
        <h4>4. Autoredoks (Disproporsionasi)</h4>
        <p>Reaksi di mana <b>satu zat yang sama</b> mengalami oksidasi sekaligus reduksi.</p>
        <p style="margin-top:8px">Contoh:<br><code>Cl₂ + 2NaOH → NaCl + NaClO + H₂O</code><br>
        Cl (0) → Cl⁻ (−1) <i>reduksi</i> &nbsp;|&nbsp; Cl (0) → ClO⁻ (+1) <i>oksidasi</i></p>
      </div>

      <div class="card">
        <h4>5. Menyetarakan Reaksi Redoks</h4>
        <p><b>Metode setengah reaksi</b> — suasana asam:</p>
        <ul>
          <li>Setarakan atom selain O dan H</li>
          <li>Setarakan O dengan menambah <code>H₂O</code></li>
          <li>Setarakan H dengan menambah <code>H⁺</code></li>
          <li>Setarakan muatan dengan menambah <code>e⁻</code></li>
        </ul>
        <p style="margin-top:9px">Suasana basa: tambahkan <code>OH⁻</code> pada kedua ruas secukupnya untuk menetralkan H⁺.</p>
      </div>

      <div class="card">
        <h4>6. Penerapan dalam Kehidupan</h4>
        <ul>
          <li><b>Korosi besi</b> — Fe oksidasi, O₂ reduksi</li>
          <li><b>Aki / baterai</b> — reaksi redoks menghasilkan listrik</li>
          <li><b>Pemutih &amp; desinfektan</b> — daya oksidasi kuat</li>
          <li><b>Fotosintesis</b> — H₂O dioksidasi, CO₂ direduksi</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section id="s-stats" class="screen">
    <div class="qtop">
      <button class="icon" data-go="home">←</button>
      <div class="qmeta"><div class="qprize" style="font-size:16px">📊 Progres &amp; Data</div></div>
      <span style="width:38px"></span>
    </div>

    <div class="chips big">
      <div class="chip"><b id="stPoin">0</b><span>TOTAL POIN</span></div>
      <div class="chip"><b id="stBest">0 / 15</b><span>LEVEL TERBAIK</span></div>
      <div class="chip"><b id="stGames">0</b><span>KUIS DIMAINKAN</span></div>
      <div class="chip"><b id="stAcc">0%</b><span>AKURASI</span></div>
    </div>

    <div class="card">
      <h3>🏅 Lencana</h3>
      <div class="badges" id="badgeList"></div>
    </div>

    <div class="card">
      <h3>📜 Riwayat Kuis</h3>
      <div class="history" id="historyList"></div>
    </div>

    <div class="card">
      <h3>💾 Penyimpanan JSON</h3>
      <p class="muted">Seluruh progres tersimpan otomatis di <b>localStorage</b> browser. Unduh sebagai file <code>.json</code> untuk backup atau dikumpulkan ke guru.</p>
      <div style="display:flex;flex-direction:column;gap:9px;margin-top:12px">
        <button class="btn primary" id="btnDownload">⬇  Unduh data .json</button>
        <label class="btn ghost" for="fileImport" style="cursor:pointer">⬆  Impor file .json</label>
        <input type="file" id="fileImport" accept=".json,application/json" hidden>
        <button class="btn danger" id="btnReset">🗑  Reset semua data</button>
      </div>
      <pre class="json-preview" id="jsonPreview"></pre>
    </div>
  </section>

</div>

<!-- ============ LADDER OVERLAY ============ -->
<div class="ladder" id="ladder">
  <div class="qtop" style="margin-bottom:14px">
    <button class="icon" id="btnLadderClose">←</button>
    <div class="qmeta"><div class="qprize" style="font-size:15px">💰 Tangga Hadiah</div></div>
