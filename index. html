let G = null;

function pickQuestions(){
  const byTier = {1:[],2:[],3:[],4:[],5:[]};
  BANK.forEach(function(q){ byTier[q.tier].push(q); });

  function tierOfRound(r){          // r = 1..15
    if(r <= 3)  return 1;
    if(r <= 6)  return 2;
    if(r <= 9)  return 3;
    if(r <= 12) return 4;
    return 5;
  }

  const used = [];
  const out  = [];
  for(let r = 1; r <= 15; r++){
    let pool = byTier[tierOfRound(r)].filter(function(q){ return used.indexOf(q.id) === -1; });
    if(!pool.length){
      pool = BANK.filter(function(q){ return used.indexOf(q.id) === -1; });
    }
    const q = pool[Math.floor(Math.random() * pool.length)];
    used.push(q.id);
    out.push(q);
  }
  return out;
}

function prep(q){
  const idx = shuffle([0,1,2,3]);
  return {
    id  : q.id,
    tier: q.tier,
    q   : q.q,
    o   : idx.map(function(i){ return q.o[i]; }),
    a   : idx.indexOf(q.a),
    ex  : q.ex,
    h   : q.h
  };
}

function startQuiz(){
  const qs = pickQuestions().map(prep);
  G = {
    round: 0,
    qs: qs,
    locked: false,
    lives: { fifty: 1, hint: 1, swap: 1 },
    correctCount: 0,
    wrongCount: 0,
    finished: false
  };
  go('quiz');
  renderQuestion();
  buildLadder();
}

function renderQuestion(){
  const q = G.qs[G.round];
  G.locked = false;

  $('qLevel').textContent = G.round + 1;
  $('qPrize').textContent = fmt(LADDER[G.round]);
  $('qBar').style.width   = (G.round / 15 * 100) + '%';
  $('qText').textContent  = q.q;

  const box = $('qOptions');
  box.innerHTML = '';
  const letters = ['A','B','C','D'];

  q.o.forEach(function(txt, i){
    const b = document.createElement('button');
    b.className = 'opt';
    b.innerHTML = '<span class="ltr">' + letters[i] + '</span><span class="tx">' + txt + '</span>';
    b.addEventListener('click', function(){ answer(i, b); });
    box.appendChild(b);
  });

  const fb = $('qFeedback');
  fb.className = 'feedback';
  fb.innerHTML = '';

  updateLifelines();
  buildLadder();
}

function updateLifelines(){
  $('lf50').className   = 'life' + (G.lives.fifty ? '' : ' used');
  $('lfHint').className = 'life' + (G.lives.hint  ? '' : ' used');
  $('lfSwap').className = 'life' + (G.lives.swap  ? '' : ' used');
}

function answer(i, btn){
  if(G.locked) return;
  G.locked = true;

  const q = G.qs[G.round];
  const opts = Array.prototype.slice.call(document.querySelectorAll('#qOptions .opt'));
  opts.forEach(function(o){ o.classList.add('dis'); });

  const fb = $('qFeedback');

  if(i === q.a){
    btn.classList.add('correct');
    sfx.correct();
    G.correctCount++;
    if(DB.mastered.indexOf(q.id) === -1) DB.mastered.push(q.id);

    fb.className = 'feedback ok show';
    fb.innerHTML = '<b>✅ Benar!</b><p>' + q.ex + '</p>';
    const nb = document.createElement('button');
    nb.className = 'btn small primary';
    nb.textContent = (G.round === 14) ? '🏆 Lihat Hasil' : 'Lanjut →';
    nb.addEventListener('click', function(){
      G.round++;
      if(G.round >= 15) endGame(true);
      else renderQuestion();
    });
    fb.appendChild(nb);

  } else {
    btn.classList.add('wrong');
    opts[q.a].classList.add('correct');
    sfx.wrong();
    G.wrongCount++;

    fb.className = 'feedback bad show';
    fb.innerHTML = '<b>❌ Belum tepat</b><p>Jawaban benar: <b>' +
                   'ABCD'[q.a] + '</b>. ' + q.ex + '</p>';
    const nb = document.createElement('button');
    nb.className = 'btn small ghost';
    nb.textContent = 'Lihat Hasil';
    nb.addEventListener('click', function(){ endGame(false); });
    fb.appendChild(nb);
  }
}

/* ---------- BANTUAN ---------- */
$('lf50').addEventListener('click', function(){
  if(!G || G.locked || !G.lives.fifty) return;
  G.lives.fifty = 0;
  sfx.lifeline();

  const q = G.qs[G.round];
  const wrongs = shuffle([0,1,2,3].filter(function(i){ return i !== q.a; }));
  const kill = wrongs.slice(0, 2);
  const opts = document.querySelectorAll('#qOptions .opt');
  kill.forEach(function(i){ opts[i].classList.add('gone'); });
  updateLifelines();
});

$('lfHint').addEventListener('click', function(){
  if(!G || G.locked || !G.lives.hint) return;
  G.lives.hint = 0;
  sfx.lifeline();

  const q = G.qs[G.round];
  const fb = $('qFeedback');
  fb.className = 'feedback ok show';
  fb.innerHTML = '<b>💡 Petunjuk</b><p>' + q.h + '</p>';
  updateLifelines();
});

$('lfSwap').addEventListener('click', function(){
  if(!G || G.locked || !G.lives.swap) return;
  G.lives.swap = 0;
  sfx.lifeline();

  const cur = G.qs[G.round];
  const usedIds = G.qs.map(function(x){ return x.id; });

  let pool = BANK.filter(function(q){
    return q.tier === cur.tier && usedIds.indexOf(q.id) === -1;
  });
  if(!pool.length){
    pool = BANK.filter(function(q){ return usedIds.indexOf(q.id) === -1; });
  }
  if(!pool.length) return;

  const nq = prep(pool[Math.floor(Math.random() * pool.length)]);
  G.qs[G.round] = nq;
  renderQuestion();
});

/* ---------- KELUAR ---------- */
$('btnQuit').addEventListener('click', function(){
  if(!G || G.finished){ go('home'); return; }
  if(confirm('Keluar dari kuis? Progres level ini akan hilang.')){
    G = null;
    go('home');
  }
});

/* =====================================================================
   10. TANGGA HADIAH
   ===================================================================== */
function buildLadder(){
  const ul = $('ladderList');
  ul.innerHTML = '';
  for(let i = 0; i < 15; i++){
    const li = document.createElement('li');
    li.innerHTML = '<span>Level ' + (i + 1) + '</span><span>' + fmt(LADDER[i]) + '</span>';
    if(SAFE_IDX.indexOf(i) !== -1) li.classList.add('safe');
    if(G){
      if(i === G.round) li.classList.add('now');
      else if(i < G.round) li.classList.add('done');
    }
    ul.appendChild(li);
  }
}

$('btnLadder').addEventListener('click', function(){
  sfx.click();
  buildLadder();
  $('ladder').classList.add('show');
});
$('btnLadderClose').addEventListener('click', function(){
  sfx.click();
  $('ladder').classList.remove('show');
});

/* =====================================================================
   11. AKHIR PERMAINAN
   ===================================================================== */
function endGame(win){
  if(!G || G.finished) return;
  G.finished = true;

  let safeIdx = -1;
  if(win) safeIdx = 14;
  else if(G.round >= 10) safeIdx = 9;
  else if(G.round >= 5)  safeIdx = 4;

  const earned = safeIdx >= 0 ? LADDER[safeIdx] : 0;
  const levelReached = win ? 15 : G.round;

  DB.totalPoin += earned;
  DB.games++;
  DB.correct += G.correctCount;
  DB.wrong   += G.wrongCount;
  DB.bestLevel = Math.max(DB.bestLevel, levelReached);

  const result = {
    correct: G.correctCount,
    wrong  : G.wrongCount
  };

  DB.history.unshift({
    tanggal : new Date().toISOString(),
    poin    : earned,
    level   : levelReached,
    benar   : G.correctCount,
    salah   : G.wrongCount,
    menang  : win
  });
  if(DB.history.length > 30) DB.history.length = 30;

  checkBadges(result);
  save();

  if(win) sfx.win();

  // Tampilkan modal
  $('mdIcon').textContent  = win ? '🏆' : (safeIdx >= 0 ? '🛡️' : '💔');
  $('mdTitle').textContent = win ? 'JUARA REDOKS!' :
                             (safeIdx >= 0 ? 'Babak Aman Tercapai!' : 'Belum Beruntung');
  $('mdSub').textContent   = win
    ? 'Luar biasa! Kamu menaklukkan seluruh 15 level reaksi redoks.'
    : (safeIdx >= 0
        ? 'Kamu berhasil melewati babak aman, poinmu tetap tersimpan.'
        : 'Coba pelajari kembali materi redoks lalu ulangi kuisnya.');

  $('mdStats').innerHTML =
    '<div><b>' + fmt(earned) + '</b><span>POIN DIDAPAT</span></div>' +
    '<div><b>' + levelReached + '/15</b><span>LEVEL DICAPAI</span></div>' +
    '<div><b>' + G.correctCount + '</b><span>JAWABAN BENAR</span></div>' +
    '<div><b>' + G.wrongCount + '</b><span>JAWABAN SALAH</span></div>';

  $('modal').classList.add('show');
}

$('mdAgain').addEventListener('click', function(){
  sfx.click();
  $('modal').classList.remove('show');
  startQuiz();
});
$('mdHome').addEventListener('click', function(){
  sfx.click();
  $('modal').classList.remove('show');
  go('home');
});

/* =====================================================================
   12. STATISTIK & DATA JSON
   ===================================================================== */
function renderStats(){
  $('stPoin').textContent  = fmt(DB.totalPoin);
  $('stBest').textContent  = DB.bestLevel + ' / 15';
  $('stGames').textContent = DB.games;

  const total = DB.correct + DB.wrong;
  $('stAcc').textContent = total ? Math.round(DB.correct / total * 100) + '%' : '0%';

  // Lencana
  const bl = $('badgeList');
  bl.innerHTML = '';
  BADGES.forEach(function(b){
    const on = DB.badges.indexOf(b.id) !== -1;
    const d = document.createElement('div');
    d.className = 'badge' + (on ? ' on' : '');
    d.title = b.desc;
    d.innerHTML = '<i>' + b.icon + '</i><span>' + b.name + '</span>';
    bl.appendChild(d);
  });

  // Riwayat
  const hl = $('historyList');
  hl.innerHTML = '';
  if(!DB.history.length){
    hl.innerHTML = '<p class="muted">Belum ada riwayat. Mainkan kuis pertamamu!</p>';
  } else {
    DB.history.forEach(function(h){
      const d = new Date(h.tanggal);
      const tgl = d.toLocaleDateString('id-ID', { day:'2-digit', month:'short' }) +
                  ' ' + d.toLocaleTimeString('id-ID', { hour:'2-digit', minute:'2-digit' });
      const row = document.createElement('div');
      row.className = 'hitem';
      row.innerHTML = '<span>' + tgl + ' · Lv ' + h.level + ' · ✔' + h.benar + ' ✘' + h.salah +
                      '</span><b>' + fmt(h.poin) + '</b>';
      hl.appendChild(row);
    });
  }

  // Preview JSON
  $('jsonPreview').textContent = JSON.stringify(DB, null, 2);
}

/* ---------- UNDUH ---------- */
$('btnDownload').addEventListener('click', function(){
  sfx.click();
  const data = JSON.stringify(DB, null, 2);
  const blob = new Blob([data], { type: 'application/json' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  const nama = (DB.player || 'siswa').replace(/[^a-z0-9]/gi, '_').toLowerCase();
  const tgl  = new Date().toISOString().slice(0, 10);
  a.href = url;
  a.download = 'redoks-quest_' + nama + '_' + tgl + '.json';
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function(){ URL.revokeObjectURL(url); }, 1500);
});

/* ---------- IMPOR ---------- */
$('fileImport').addEventListener('change', function(e){
  const file = e.target.files && e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = function(ev){
    try{
      const parsed = JSON.parse(ev.target.result);
      DB = Object.assign(JSON.parse(JSON.stringify(DEFAULT_DB)), parsed);
      save();
      renderStats();
      updateHome();
      alert('✅ Data berhasil diimpor!');
    }catch(err){
      alert('❌ File tidak valid. Pastikan berupa file .json hasil unduhan.');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
});

/* ---------- RESET ---------- */
$('btnReset').addEventListener('click', function(){
  if(!confirm('Hapus SEMUA data progres? Tindakan ini tidak bisa dibatalkan.')) return;
  DB = JSON.parse(JSON.stringify(DEFAULT_DB));
  save();
  renderStats();
  updateHome();
  alert('🗑 Semua data telah direset.');
});

/* =====================================================================
   13. INISIALISASI
   ===================================================================== */
$('btnStart').addEventListener('click', function(){
  sfx.click();
  const nama = $('playerName').value.trim();
  if(nama){ DB.player = nama.slice(0, 18); save(); }
  startQuiz();
});

updateHome();
buildLadder();
console.log('%c⚡ Redoks Quest siap dimainkan!', 'color:#3ddc97;font-weight:bold;font-size:14px');
</script>
