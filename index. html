   2. THREE.JS — latar 3D "transfer elektron"
   ===================================================================== */
let scene, camera, renderer, clock, world, curve, electrons = [];
let glOK = false;

function makeAtom(x, y, z, color){
  const g = new THREE.Group();
  g.position.set(x, y, z);

  const core = new THREE.Mesh(
    new THREE.IcosahedronGeometry(1.22, 1),
    new THREE.MeshStandardMaterial({
      color: color, emissive: color, emissiveIntensity: .35,
      roughness: .35, metalness: .55, flatShading: true
    })
  );
  g.add(core);

  const wire = new THREE.Mesh(
    new THREE.IcosahedronGeometry(1.72, 1),
    new THREE.MeshBasicMaterial({ color: color, wireframe: true, transparent: true, opacity: .2 })
  );
  g.add(wire);

  const halo = new THREE.Mesh(
    new THREE.RingGeometry(2.0, 2.12, 48),
    new THREE.MeshBasicMaterial({ color: color, transparent: true, opacity: .22, side: THREE.DoubleSide })
  );
  halo.rotation.x = Math.PI * 0.42;
  g.add(halo);

  g.userData.core = core;
  g.userData.wire = wire;
  g.userData.halo = halo;
  return g;
}

function initGL(){
  const cv = document.getElementById('bg');
  renderer = new THREE.WebGLRenderer({ canvas: cv, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

  scene  = new THREE.Scene();
  camera = new THREE.PerspectiveCamera(45, 1, .1, 200);
  camera.position.set(0, 0, 13);
  clock  = new THREE.Clock();

  scene.add(new THREE.AmbientLight(0x5577cc, 1.5));

  const l1 = new THREE.PointLight(0xff9a4d, 2.4, 90); l1.position.set(-8, 7, 10); scene.add(l1);
  const l2 = new THREE.PointLight(0x4d8dff, 2.4, 90); l2.position.set( 9,-6,  8); scene.add(l2);
  const l3 = new THREE.PointLight(0xa86bff, 1.6, 90); l3.position.set( 0,-9, -6); scene.add(l3);

  world = new THREE.Group();
  scene.add(world);

  world.add(makeAtom(-3.1,  .8, 0, 0xff8a3d)); // reduktor
  world.add(makeAtom( 3.1, -.8, 0, 0x4d8dff)); // oksidator

  curve = new THREE.CatmullRomCurve3([
    new THREE.Vector3(-2.0,  .8, 0),
    new THREE.Vector3(-0.9, 2.9, 1.4),
    new THREE.Vector3( 0.9, 2.9, 1.4),
    new THREE.Vector3( 2.0, -.8, 0)
  ]);

  const eg = new THREE.SphereGeometry(.20, 14, 14);
  for(let i = 0; i < 4; i++){
    const e = new THREE.Mesh(eg, new THREE.MeshBasicMaterial({ color: 0x7cffcb }));
    const glow = new THREE.Mesh(
      new THREE.SphereGeometry(.42, 12, 12),
      new THREE.MeshBasicMaterial({ color: 0x7cffcb, transparent: true, opacity: .16 })
    );
    e.add(glow);
    e.userData.off = i / 4;
    world.add(e);
    electrons.push(e);
  }

  // Bintang latar
  const N = 280, pos = new Float32Array(N * 3);
  for(let i = 0; i < N; i++){
    pos[i*3]   = (Math.random() - .5) * 70;
    pos[i*3+1] = (Math.random() - .5) * 70;
    pos[i*3+2] = (Math.random() - .5) * 45 - 12;
  }
  const sg = new THREE.BufferGeometry();
  sg.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  scene.add(new THREE.Points(sg, new THREE.PointsMaterial({
    color: 0x88aaff, size: .13, transparent: true, opacity: .55
  })));

  glOK = true;
  onResize();
  animate();
}

function onResize(){
  if(!glOK) return;
  const cv = renderer.domElement;
  const w = cv.clientWidth || window.innerWidth;
  const h = cv.clientHeight || window.innerHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();

  const visH = 2 * camera.position.z * Math.tan(THREE.MathUtils.degToRad(22.5));
  const visW = visH * camera.aspect;
  const s = Math.min(visW / 9.6, visH / 7.6, 1.25);
  world.scale.setScalar(Math.max(s, .35));
}

function animate(){
  requestAnimationFrame(animate);
  if(!glOK) return;
  const t = clock.getElapsedTime();

  world.rotation.y = Math.sin(t * .24) * .46;
  world.rotation.x = Math.sin(t * .18) * .14;
  world.position.y = Math.sin(t * .6) * .28;

  world.children.forEach(function(c){
    if(c.userData.wire){
      c.rotation.y += .006;
      c.rotation.x += .003;
      c.userData.halo.rotation.z += .008;
      const p = 1 + Math.sin(t * 2 + c.position.x) * .04;
      c.userData.core.scale.setScalar(p);
    }
  });

  electrons.forEach(function(e, i){
    const u = (t * .15 + e.userData.off) % 1;
    e.position.copy(curve.getPoint(u));
    const s = 1 + Math.sin(u * Math.PI * 2) * .18;
    e.scale.setScalar(s);
  });

  renderer.render(scene, camera);
}

try { initGL(); } catch(err){ console.warn('WebGL tidak tersedia:', err); }
window.addEventListener('resize', onResize);
window.addEventListener('orientationchange', function(){ setTimeout(onResize, 250); });

